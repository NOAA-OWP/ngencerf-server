# Docker doesn't give us a way to get this automatically.
# We need to know the path of the user's directory that maps to NGEN_CAL_MOUNT_POINT
NGEN_CAL_DATA_PATH=/ngencerf-app/data/ngen-cal-data/

# Path to singularity containers
# Used to retrieve software version information
CONTAINER_PATH=/ngencerf-app/singularity

MSWM_TAG=development

NGEN_FORCING_TAG=development

DATA_ASSIMILATION_TAG=development

# Path to a gitlab personal access token (PAT)
# used to checkout python modules from gitlab
GITLAB_TOKEN_PATH=~/.gitlab_token
