CERF_VENV=Docker
# Note that when running in a container, the .init directory must be created beforehand and have the appropriate mapping
RUN_CERF_FLAG_DIRECTORY=/ngencerf/ngencerf-server/.init
DJANGO_SUPERUSER_EMAIL=admin@nextgenwaterprediction.com
DJANGO_SUPERUSER_PASSWORD=admin
PORT=8000

# Default off so the dev image falls through to manage.py runserver.
# Prod opts in via cerfServer/.env-docker-prod (loaded by production-pw.yaml).
CERF_ASGI=${CERF_ASGI:-0}
CERF_PRODUCTION=${CERF_PRODUCTION:-0}
GUNICORN_WORKERS=24
GUNICORN_MAX_REQUESTS=300
GUNICORN_MAX_REQUESTS_JITTER=100
GUNICORN_GRACEFUL_TIMEOUT=120
