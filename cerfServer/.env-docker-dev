# -------------------------------------------------------------------
#  -env-docker-dev
# Base environment file for development deployments using Docker
#
# This file defines environment variables that are:
#   - Injected into the container environment via docker-compose
#   - Source-controlled
#   - Static across all development deployments
#
# IMPORTANT:
#   - No deployment-specific, secret, or per-cluster values belong here
#   - Values that vary by deployment MUST be defined in a separate
#     deployment-specific .env-override file
#
# PLACEHOLDERS:
#   - Some variables in this file are intentionally left blank
#   - These act as REQUIRED placeholders (e.g. CERF_SERVER_SECRET_KEY)
#   - They MUST be set in the deployment-specific .env-override file
#
# The .env-override file:
#   - Is NOT source-controlled
#   - Is referenced by docker-compose (if present)
#   - Provides secrets and cluster-specific overrides
#   - Has no template by design
# -------------------------------------------------------------------

CERF_SERVER_SQL_LOGGING=False

# SECURITY WARNING: don't run with debug turned on in production!
DJANGO_DEBUG=True

NGEN_ENVIRONMENT=DOCKER

