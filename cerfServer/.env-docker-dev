# -------------------------------------------------------------------
#  -env-docker-dev
# Base environment file for development deployments using Docker
#
# This file defines environment variables that are:
#   - Injected into the container environment via docker-compose
#   - Source-controlled
#   - Static across all development deployments
#
# IMPORTANT:
#   - No deployment-specific, secret, or per-cluster values belong here
#   - Values that vary by deployment MUST be defined in a separate
#     deployment-specific .env-override file
#
# PLACEHOLDERS:
#   - Some variables in this file are intentionally left blank
#   - These act as REQUIRED placeholders (e.g. CERF_SERVER_SECRET_KEY)
#   - They MUST be set in the deployment-specific .env-override file
#
# The .env-override file:
#   - Is NOT source-controlled
#   - Is referenced by docker-compose (if present)
#   - Provides secrets and cluster-specific overrides
#   - Has no template by design
# -------------------------------------------------------------------

# Use fully open ALLOWED_HOSTS because ParallelWorks SSH tunnel connections
# come from arbitrary private IPs
# FIXME: Use stricter ALLOWED_HOSTS rules if possible in the future
ALLOWED_HOSTS=*

NGENCERF_ROOT_LOG_LEVEL=INFO
NGENCERF_LOG_LEVEL=DEBUG
NGENCERF_DATABASE_LOG_LEVEL=WARNING
NGENCERF_CALIBRATION_LOG_LEVEL=DEBUG
NGENCERF_DJANGO_LOG_LEVEL=INFO

# SECURITY WARNING: don't run with debug turned on in production!
DJANGO_DEBUG=True

JOB_EXECUTION_MODE=DOCKER

ENTERPRISE_DATA_URL='http://edfs.test.nextgenwaterprediction.com/'
ENTERPRISE_DATA_ENV=test

REDIS_URL=redis://redis:6379/1

# DB host/sslmode for docker compose. Creds are baked into compose.yaml, so dev does not neeed to create any DB creds.
CERF_SERVER_DATABASE_HOST=db
CERF_SERVER_DATABASE_SSLMODE=disable

# ---------------------------
# Cluster specific data below which should be defined in the deployment-specific .env-override or injected via Docker
# ----------------------------

# For development, it's ok if all deployments use the same secret-key.  No need to override
CERF_SERVER_SECRET_KEY='django-insecure-gmuchz(a93zw!8+75r+2%nx)mxvz*m(z9%%+i(#t6$1cg!8cg8'

# For development you must define your own s3 directory to hold archived directories
# for example, NGENCERF_ARCHIVE_S3_PATH=s3://ngwpc-dev/peter.kronenberg/ngencerf_archive/
# It is also important to create a dummy file in the directory since empty directories on S3 are ephemeral.  See README
NGENCERF_ARCHIVE_S3_PATH=

# For development you must define your own s3 directory to hold zip files
# for example, NGENCERF_ZIPS_S3_PATH=s3://ngwpc-dev/peter.kronenberg/ngencerf_zips/
# It is also important to create a dummy file in the directory since empty directories on S3 are ephemeral.  See README
NGENCERF_ZIPS_S3_PATH=
