# -------------------------------------------------------------------
#  -env-docker-prod
# Base environment file for Parallel Works deployments
#
# This file defines environment variables that are:
#   - Injected into the container environment via docker-compose
#   - Source-controlled
#   - Static across all Parallel Works deployments
#
# IMPORTANT:
#   - No deployment-specific, secret, or per-cluster values belong here
#   - Values that vary by deployment MUST be defined in a separate
#     deployment-specific .env-override file
#
# PLACEHOLDERS:
#   - Some variables in this file are intentionally left blank
#   - These act as REQUIRED placeholders (e.g. CERF_SERVER_SECRET_KEY)
#   - They MUST be set in the deployment-specific .env-override file
#
# The .env-override file:
#   - Is NOT source-controlled
#   - Is referenced by docker-compose (if present)
#   - Provides secrets and cluster-specific overrides
#   - Has no template by design
# -------------------------------------------------------------------

CERF_SERVER_SQL_LOGGING=False

SLURM_URL='http://172.17.0.1:5000'

# SECURITY WARNING: don't run with debug turned on in production!
DJANGO_DEBUG=False

NGEN_ENVIRONMENT=PARALLEL_WORKS

REDIS_URL=redis://redis:6379/1

# Default values which can be overridden in .env-override
MPI_NODE_RULES='[[10, 1], [50, 2], [250, 8], [-1, 16]]'

# ----------------------------------------------------------------------------------------------
# Cluster specific data below which should be defined in the deployment-specific .env-override
# ----------------------------------------------------------------------------------------------

# Secret key should be unique for each deployment
CERF_SERVER_SECRET_KEY=

# Each cluster must define its own unique directory under s3://ngwpc-ngencerf-archive
# It is also important to create a dummy file in the directory since empty directories on S3 are ephemeral.  See README
# NGENCERF_ARCHIVE_S3_PATH=s3://ngwpc-ngencerf-archive/integration/
NGENCERF_ARCHIVE_S3_PATH=

# Postgres database
CERF_SERVER_DATABASE_NAME=
CERF_SERVER_DATABASE_USER=
CERF_SERVER_DATABASE_PASSWORD=
CERF_SERVER_DATABASE_HOST=

# Data Services URL for hydrofabric data ##
ENTERPRISE_DATA_URL=

