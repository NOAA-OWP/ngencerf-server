# This is a template for the .env file which can be used to load settings in settings.py
# Copy it to .env and add your custom/local settings for your environment
# OR just set the appropriate values in the environment
# The values in this template file are suitable for Development, except for NGENCERF_ARCHIVE_S3_PATH

# __.env is checked into git.  .env is not

NGENCERF_ROOT_LOG_LEVEL=INFO
NGENCERF_LOG_LEVEL=DEBUG
NGENCERF_DATABASE_LOG_LEVEL=WARNING
NGENCERF_CALIBRATION_LOG_LEVEL=DEBUG
NGENCERF_DJANGO_LOG_LEVEL=INFO

CERF_SERVER_SECRET_KEY='django-insecure-gmuchz(a93zw!8+75r+2%nx)mxvz*m(z9%%+i(#t6$1cg!8cg8'

CERF_SERVER_DATABASE_NAME=postgres
CERF_SERVER_DATABASE_PASSWORD=postgres

# SECURITY WARNING: don't run with debug turned on in production!
DJANGO_DEBUG=True

# Each pair represents [max_catchments, num_nodes]
MPI_NODE_RULES='[[15, 1], [50, 2], [250, 4], [500, 6], [1000, 10], [1500, 12], [-1, 18]]'

MFA_ENABLED=False
ACTIVE_DIRECTORY_ENABLED=False

JOB_EXECUTION_MODE=DOCKER

ENTERPRISE_DATA_ENV='test'
ENTERPRISE_DATA_URL='http://edfs.test.nextgenwaterprediction.com/'

# For development on AWS Workspace, you must define your own s3 directory
# for example, NGENCERF_ARCHIVE_S3_PATH=s3://ngwpc-dev/peter.kronenberg/ngencerf_archive/
NGENCERF_ARCHIVE_S3_PATH=

# For development on AWS Workspace, you must define your own s3 directory
# for example, NGENCERF_ZIPS_S3_PATH=s3://ngwpc-dev/peter.kronenberg/ngencerf_zips/
NGENCERF_ZIPS_S3_PATH=

LDAP_BIND_DN=<required LDAP credentials>
LDAP_BIND_PASSWORD=<required LDAP credentials>

# Values are local, dev, oe
# local is for devs running in AWS Workspace
# dev is for deployments DEV, DEV, INTEGRATION
# oe is for EA, UAT
LDAP_SYSTEM_NAME=local
